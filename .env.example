# Copy to .env.local and fill in. Never commit .env.local.
# NEXT_PUBLIC_* values are sent to the browser; everything else is server-only.

# --- App ---------------------------------------------------------------------
# Public base URL: used in table QR codes and as the checkout return URL.
# Bachs rejects localhost return URLs, so to pay locally set this to a tunnel
# (e.g. `cloudflared tunnel --url http://localhost:3000`) or a preview deploy.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret that cron/job endpoints require (refund timeouts, nightly settlement).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Supabase ----------------------------------------------------------------
# Local: run `npm run db:start`, then copy the API URL, Publishable key and
# Secret key from `npm run db:status`.
# Hosted: Project Settings -> API Keys (project in an EU region).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Bypasses RLS. Server-only (webhooks, cron jobs, admin actions).
SUPABASE_SECRET_KEY=
# Hosted project ref, for `supabase link` and type generation against remote.
SUPABASE_PROJECT_REF=

# --- Bachs payments (sandbox until told otherwise) ----------------------------
# Dashboard -> Developers -> API keys. Must start with sk_sandbox_.
BACHS_SECRET_KEY=
# Signing secret for webhooks. Locally it's printed by
#   bachs listen --forward-to localhost:3000/api/webhooks/bachs
# (new per session). In production it's the registered endpoint's secret.
# While unset, the webhook route answers 503 so Bachs retries later.
BACHS_WEBHOOK_SECRET=

# --- SMS: Termii (phone OTP via Supabase's Send SMS auth hook) ---------------
# Not needed locally: use Supabase test OTPs ([auth.sms.test_otp] in supabase/config.toml).
TERMII_API_KEY=
# Approved alphanumeric sender ID registered with Termii.
TERMII_SENDER_ID=
# Your account's base URL from the Termii dashboard.
TERMII_BASE_URL=https://v3.api.termii.com
# Secret of Supabase's Send SMS auth hook ("v1,whsec_..."). Locally it must
# match [auth.hook.send_sms] secrets in supabase/config.toml.
SEND_SMS_HOOK_SECRET=

# --- Monitoring: Sentry -------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for source map upload.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Analytics: PostHog -------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
# EU cloud, to match data residency
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
